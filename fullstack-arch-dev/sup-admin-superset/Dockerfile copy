# Start from official Arch Linux base image
FROM archlinux:latest

# Set environment variables for locale and terminal
ENV TERM=xterm-256color
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Generate and set locale
RUN sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
  locale-gen && \
  echo "LANG=en_US.UTF-8" > /etc/locale.conf

# User variables
ARG USER=devuser
ARG UID=1000
ARG GID=1000
ENV HOME=/home/$USER

# Install base system packages
RUN pacman -Syu --noconfirm && \
  pacman -S --noconfirm \
  base-devel \
  sudo \
  git \
  curl \
  wget \
  unzip \
  zsh \
  vim \
  tmux \
  tree \
  htop \
  less \
  openssh \
  openssl \
  cmake \
  gcc \
  make \
  python \
  python-pip \
  python-setuptools \
  python-wheel \
  libffi \
  mariadb \
  mariadb-libs \
  postgresql \
  postgresql-libs \
  redis \
  php \
  php-gd \
  php-intl \
  composer \
  nodejs \
  npm \
  yarn \
  typescript \
  ts-node && \
  pacman -Scc --noconfirm && \
  rm -rf /var/cache/pacman/pkg/*

# Create a non-root user
RUN groupadd -g $GID $USER && \
  useradd -m -u $UID -g $GID -s /bin/zsh $USER && \
  echo "$USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USER && \
  chmod 0440 /etc/sudoers.d/$USER

# Switch to the new user
USER $USER
WORKDIR /home/$USER

# Install NVM and global Node tools
ENV NVM_DIR=$HOME/.nvm
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash && \
  echo 'export NVM_DIR="$HOME/.nvm"' >> ~/.zshrc && \
  echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> ~/.zshrc && \
  bash -c "source $NVM_DIR/nvm.sh && \
  nvm install --lts && \
  nvm use --lts && \
  npm install -g @angular/cli create-next-app"

# Install pyenv and Python 3.11.9
ENV PYENV_ROOT=$HOME/.pyenv
ENV PATH="$PYENV_ROOT/bin:$PATH"
RUN git clone https://github.com/pyenv/pyenv.git $PYENV_ROOT && \
  echo 'export PYENV_ROOT="$HOME/.pyenv"' >> ~/.zshrc && \
  echo 'export PATH="$PYENV_ROOT/bin:$PATH"' >> ~/.zshrc && \
  echo 'eval "$(pyenv init --path)"' >> ~/.zshrc && \
  bash -c "source ~/.zshrc && pyenv install 3.11.9 && pyenv global 3.11.9"

# Export pyenv Python path for later use
ENV PATH="$PYENV_ROOT/versions/3.11.9/bin:$PATH"

# Install Laravel globally
RUN composer global require laravel/installer && \
  echo 'export PATH="$HOME/.composer/vendor/bin:$PATH"' >> ~/.zshrc

# Create Python venv and install Superset + MySQL/Redis/PGSQL drivers
RUN python -m venv superset-env && \
  ./superset-env/bin/pip install --upgrade pip setuptools wheel && \
  ./superset-env/bin/pip install \
  apache-superset \
  mysqlclient \
  redis \
  psycopg2-binary \
  python-dotenv \
  python-memcached

# Expose dev + Superset ports
EXPOSE 3000 4200 8000 8080 8088 5432 3306 6379

# Default shell
CMD ["zsh"]
