# ============================================================
# ⚡ Global Developer Aliases
# ============================================================

# Directory shortcuts
alias ws="cd ~/workspace"
alias ll="ls -alF --color=auto"
alias la="ls -A"
alias l="ls -CF"

# Git shortcuts
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline --graph --decorate"

# Python shortcuts
alias py="python3"
alias pip-upgrade="python3 -m pip install --upgrade pip setuptools wheel"

# Node / NPM / Yarn
alias ni="npm install"
alias nr="npm run"
alias yd="yarn dev"
alias ys="yarn start"

# Docker helpers
alias dcu="docker-compose up -d"
alias dcd="docker-compose down"
alias dcr="docker-compose restart"

# Zsh
alias reload="source ~/.zshrc"

# System info
alias myip="curl ifconfig.me"
alias ports="sudo lsof -i -P -n | grep LISTEN"
